# ---------------------------------------------------------------
# Copy to .env and fill in. NEVER commit .env (it is gitignored).
# In CI (GitHub Actions) the same names are set as repository
# secrets / variables (Settings > Secrets and variables > Actions).
#
# Quick start:
#   cp .env.example .env              # then fill in the shop you want to test
#   npx playwright test --project=chromium
#   PROJECT=hqpatronen npx playwright test --project=chromium   # one-off shop switch
# ---------------------------------------------------------------

# Which shop profile to load from ./projects/<PROJECT>.ts
# One of: hdtoner, hdtonerch, hdtonerat, hqpatronen, hqpatronench,
#         hqpatronen24_ch, tintencenter, druckerpatronen
PROJECT=

# Storefront base URL per shop (only the selected shop's is read).
# STAGING only: the suite refuses production hosts (www.*). Example: https://staging.hd-toner.at
BASE_URL_HDTONER=
BASE_URL_HDTONERCH=
BASE_URL_HDTONERAT=
BASE_URL_HQPATRONEN=
BASE_URL_HQPATRONENCH=
BASE_URL_HQPATRONEN24_CH=
BASE_URL_TINTENCENTER=
BASE_URL_DRUCKERPATRONEN=
# Optional generic fallback if the shop-specific URL above is empty
BASE_URL=

# --- HTTP basic auth (staging environments behind .htaccess) -----
HTTP_USERNAME=
# One password per shop: HTTP_PASSWORD_<PROJECT> wins over the generic HTTP_PASSWORD.
# (In CI each job only gets the password of its own shop.)
HTTP_PASSWORD=
HTTP_PASSWORD_HDTONER=
HTTP_PASSWORD_HDTONERCH=
HTTP_PASSWORD_HDTONERAT=
HTTP_PASSWORD_HQPATRONEN=
HTTP_PASSWORD_HQPATRONENCH=
HTTP_PASSWORD_HQPATRONEN24_CH=
HTTP_PASSWORD_TINTENCENTER=
HTTP_PASSWORD_DRUCKERPATRONEN=

# --- Admin API (test data setup + cleanup of created customers) --
# Create an integration in the shop admin: Settings > System > Integrations > Add integration
# (give it the rights to read/delete customers and read sales channels, or enable "Administrator").
# The secret is shown only once when it is created.
#
# Per shop (use this when you test several shops, each shop has its own integration):
#   <PROJECT>_ADMIN_CLIENT_ID / <PROJECT>_ADMIN_CLIENT_SECRET
HDTONER_ADMIN_CLIENT_ID=
HDTONER_ADMIN_CLIENT_SECRET=
HDTONERCH_ADMIN_CLIENT_ID=
HDTONERCH_ADMIN_CLIENT_SECRET=
HDTONERAT_ADMIN_CLIENT_ID=
HDTONERAT_ADMIN_CLIENT_SECRET=
HQPATRONEN_ADMIN_CLIENT_ID=
HQPATRONEN_ADMIN_CLIENT_SECRET=
HQPATRONENCH_ADMIN_CLIENT_ID=
HQPATRONENCH_ADMIN_CLIENT_SECRET=
HQPATRONEN24_CH_ADMIN_CLIENT_ID=
HQPATRONEN24_CH_ADMIN_CLIENT_SECRET=
TINTENCENTER_ADMIN_CLIENT_ID=
TINTENCENTER_ADMIN_CLIENT_SECRET=
DRUCKERPATRONEN_ADMIN_CLIENT_ID=
DRUCKERPATRONEN_ADMIN_CLIENT_SECRET=
# Generic fallback (used when a shop has no per-shop pair above)
ADMIN_CLIENT_ID=
ADMIN_CLIENT_SECRET=
# Alternative to an integration: an admin user (password grant)
# NOTE: wrap values containing # or spaces in quotes, e.g. ADMIN_PASSWORD="abc#123"
#       (unquoted, everything after # is treated as a comment)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Store API ---------------------------------------------------
# Sales channel access key. If empty, it is resolved automatically via
# the Admin API by matching the base URL against the sales channel domains.
SW_ACCESS_KEY=

# --- Safety switches ---------------------------------------------
# Set to false for production-like environments: skips tests that
# create customers, place orders or submit forms. Default: true
ALLOW_WRITE_TESTS=true
# Delete customers created by the tests afterwards (needs Admin API credentials). Default: true
CLEANUP_TEST_DATA=true

# --- Browsers ----------------------------------------------------
# Browsers to run in addition to chromium + mobile: firefox,webkit
# Leave empty if a browser does not work on your machine (CI sets firefox itself).
EXTRA_BROWSERS=
